# Tanda token (OAuth password grant). Generate it with:
# curl https://my.tanda.co/api/oauth/token -X POST -H "Cache-Control: no-cache" \
#   -F "username=YOUR_EMAIL" -F "password=YOUR_PASSWORD" \
#   -F "scope=me timesheet roster user department" -F "grant_type=password"
# Paste ONLY the "access_token" value from the response here. Never commit this file with the real value.
TANDA_API_TOKEN=

# Tanda API base URL (usually no need to change it)
TANDA_BASE_URL=https://my.tanda.co

# Default organisation for the X-Organisation-Id header
# (replace with your own Tanda organisation ID)
TANDA_DEFAULT_ORG_ID=999999

# Port the backend listens on
PORT=3000

# Comma-separated origins allowed to call this API (CORS). Defaults to the
# local frontend dev server if left empty.
CORS_ORIGIN=http://localhost:3001

# Comma-separated Tanda employee IDs that have a contract but are paid
# overtime directly instead of banking it as TOIL. They're grouped with
# "casual" in the casual/contract filter, since they're the ones that
# actually need overtime monitoring. Their badge still shows "Contract".
# Example (replace with your own employee IDs): 1000001,1000002
TANDA_OVERTIME_PAID_CONTRACT_IDS=1000001
